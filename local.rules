# =====================================================================
# CodeAlpha_NetworkIntrusionDetectionSystem — Custom Suricata Rules
# File: local.rules
# Place in your Suricata rules directory (check default-rule-path in
# suricata.yaml) and reference it in suricata.yaml under rule-files
# =====================================================================
# SID range 9000000-9000999 is reserved here for custom/local rules
# to avoid colliding with Emerging Threats / community rule SIDs.
# =====================================================================

# --- Reconnaissance / Scanning -------------------------------------

# Detect classic Nmap SYN/connect scans (many SYNs, few completed sessions)
alert tcp any any -> $HOME_NET any (msg:"LOCAL Possible Nmap TCP Scan Detected"; \
    flags:S; flow:stateless; threshold:type both, track by_src, count 20, seconds 5; \
    classtype:attempted-recon; sid:9000001; rev:1;)

# Detect Nmap OS fingerprinting / null scans
alert tcp any any -> $HOME_NET any (msg:"LOCAL Null Scan Detected"; \
    flags:0; threshold:type both, track by_src, count 5, seconds 10; \
    classtype:attempted-recon; sid:9000002; rev:1;)

# Detect ICMP sweep (host discovery)
alert icmp any any -> $HOME_NET any (msg:"LOCAL ICMP Ping Sweep Detected"; \
    itype:8; threshold:type both, track by_src, count 10, seconds 5; \
    classtype:attempted-recon; sid:9000003; rev:1;)

# --- Brute Force Attempts -------------------------------------------

# SSH brute force (repeated connection attempts to port 22)
alert tcp any any -> $HOME_NET 22 (msg:"LOCAL Possible SSH Brute Force"; \
    flags:S; threshold:type both, track by_src, count 5, seconds 60; \
    classtype:attempted-admin; sid:9000010; rev:1;)

# FTP brute force
alert tcp any any -> $HOME_NET 21 (msg:"LOCAL Possible FTP Brute Force"; \
    content:"USER"; threshold:type both, track by_src, count 5, seconds 60; \
    classtype:attempted-admin; sid:9000011; rev:1;)

# HTTP login brute force (basic auth failures pattern)
alert http any any -> $HOME_NET any (msg:"LOCAL Repeated HTTP 401 Unauthorized (possible brute force)"; \
    flow:established,to_client; http.stat_code; content:"401"; \
    threshold:type both, track by_src, count 5, seconds 60; \
    classtype:attempted-admin; sid:9000012; rev:1;)

# --- Web Application Attacks ----------------------------------------

# Basic SQL injection attempt in URI
alert http any any -> $HOME_NET any (msg:"LOCAL Possible SQL Injection in URI"; \
    flow:established,to_server; http.uri; \
    pcre:"/(\%27)|(\')|(\-\-)|(\%23)|(#)/i"; \
    classtype:web-application-attack; sid:9000020; rev:1;)

# Basic XSS attempt in URI
alert http any any -> $HOME_NET any (msg:"LOCAL Possible XSS Attempt in URI"; \
    flow:established,to_server; http.uri; content:"<script"; nocase; \
    classtype:web-application-attack; sid:9000021; rev:1;)

# Directory traversal attempt
alert http any any -> $HOME_NET any (msg:"LOCAL Directory Traversal Attempt"; \
    flow:established,to_server; http.uri; content:"../"; \
    classtype:web-application-attack; sid:9000022; rev:1;)

# Suspicious User-Agent (common scanner/tool signatures)
alert http any any -> $HOME_NET any (msg:"LOCAL Suspicious Scanner User-Agent"; \
    flow:established,to_server; http.user_agent; \
    pcre:"/(nikto|sqlmap|nmap|masscan|gobuster|dirbuster)/i"; \
    classtype:attempted-recon; sid:9000023; rev:1;)

# --- Malware / C2 Indicators -----------------------------------------

# Unusually long DNS queries (possible DNS tunneling)
alert dns any any -> any any (msg:"LOCAL Possible DNS Tunneling - Long Query"; \
    dns.query; dsize:>60; \
    classtype:trojan-activity; sid:9000030; rev:1;)

# Outbound connection on common C2/backdoor ports
alert tcp $HOME_NET any -> any [4444,1337,6667] (msg:"LOCAL Outbound Traffic to Known Suspicious Port"; \
    flags:S; classtype:trojan-activity; sid:9000031; rev:1;)

# Large outbound ICMP payload (possible ICMP tunneling / data exfil)
alert icmp $HOME_NET any -> any any (msg:"LOCAL Oversized ICMP Packet (possible tunneling)"; \
    dsize:>800; classtype:trojan-activity; sid:9000032; rev:1;)

# --- Policy / Hygiene --------------------------------------------------

# Plaintext Telnet usage (insecure protocol)
alert tcp any any -> $HOME_NET 23 (msg:"LOCAL Telnet Connection Attempt (insecure protocol)"; \
    flow:to_server; classtype:policy-violation; sid:9000040; rev:1;)

# Cleartext FTP login (credentials in the clear)
alert tcp any any -> $HOME_NET 21 (msg:"LOCAL FTP Cleartext Login Detected"; \
    content:"PASS"; classtype:policy-violation; sid:9000041; rev:1;)
